# Required. Get a key at https://console.groq.com
GROQ_API_KEY=

# Required. A long random string. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Database. SQLite is fine locally; use a PostgreSQL URL when deploying.
DATABASE_URL=sqlite:///./cartcare.db

# Allowed frontend addresses, separated by commas.
CORS_ORIGINS=http://localhost:5173